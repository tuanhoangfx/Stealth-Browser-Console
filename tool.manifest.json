{
  "schemaVersion": 1,
  "code": "P0003",
  "id": "stealth-browser-console",
  "aliases": [
    "P0003",
    "Stealth",
    "Stealth Browser Console"
  ],
  "name": "Stealth Browser Console",
  "type": "Desktop",
  "owner": "Tool",
  "status": "Beta",
  "summary": "Standalone desktop console for CloakBrowser antidetect profiles and local automation.",
  "stack": [
    "Electron",
    "React",
    "Vite",
    "CloakBrowser",
    "SQLite"
  ],
  "devPort": 5175,
  "uiShell": {
    "golden": "P0020",
    "mainMode": "directory",
    "splitScreens": [
      "profiles",
      "workflow",
      "system"
    ],
    "userFooter": "workspace"
  },
  "manualCheck": {
    "packagedBuild": "pnpm desktop:run",
    "packagedBuildScript": "node scripts/desktop-open.mjs",
    "devReload": "node scripts/dev-icon-reload.mjs",
    "profilesPartialPageSmoke": "node scripts/smoke-profiles-partial-page.mjs http://127.0.0.1:5175/?stealthSmokePager=1",
    "neverTaskkillPackagedExe": true,
    "notes": "User manual check: packaged = desktop:run (no --replace). Dev hot-reload = dev-icon-reload. Never taskkill Stealth Browser Console.exe unless user explicitly requests --replace."
  },
  "commands": {
    "dev": "corepack pnpm dev",
    "dev:web": "corepack pnpm dev:web",
    "desktop:run": "node scripts/desktop-open.mjs",
    "build": "corepack pnpm build",
    "smoke": "corepack pnpm test:smoke",
    "preview": "corepack pnpm preview",
    "package": "corepack pnpm desktop:dist",
    "release": "corepack pnpm desktop:release",
    "desktop:release:patch": "corepack pnpm desktop:release:patch",
    "desktop:release:minor": "corepack pnpm desktop:release:minor",
    "desktop:release:major": "corepack pnpm desktop:release:major",
    "desktop:snapshot-good": "node scripts/snapshot-known-good.mjs",
    "desktop:restore-good": "powershell -ExecutionPolicy Bypass -File scripts/restore-known-good.ps1 -LaunchOnly -PurgeSurfshark"
  },
  "knownGood": {
    "config": "config/known-good.json",
    "tagSuffix": "-stable",
    "snapshot": "node scripts/snapshot-known-good.mjs",
    "restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-known-good.ps1",
    "workspaceSnapshot": "node ../scripts/snapshot-known-good.mjs --code P0003",
    "workspaceRestore": "powershell -ExecutionPolicy Bypass -File ../scripts/restore-known-good.ps1 -Code P0003"
  },
  "docs": {
    "readme": "README.md",
    "context": "PROJECT_CONTEXT.md",
    "release": "RELEASE.md",
    "architecture": "ARCHITECTURE.md"
  },
  "directoryDisplayPrefs": {
    "ssot": "src/lib/stealth-display-panel-config.tsx",
    "profiles": {
      "module": "src/features/profiles/profile-directory-prefs.ts",
      "scope": "Profiles tab directory table only",
      "columnStorageKey": "p0003_profile_directory_columns",
      "presetsStorageKey": "p0003_profile_directory_column_presets",
      "displayPanelVariant": "panel",
      "panelFillRows": "pageSize",
      "partialPagePad": "invisible"
    },
    "workflowRail": {
      "module": "src/features/workflows/workflow-directory-prefs.ts",
      "scope": "Workflow split left rail (Run History + Console workspace)",
      "columnStorageKey": "p0003_workflow_rail_directory_columns",
      "presetsStorageKey": "p0003_workflow_rail_directory_column_presets",
      "displayPanelVariant": "rail",
      "fixedRows": 5,
      "partialPagePad": "visible"
    },
    "workflowPanel": {
      "module": "src/features/workflows/workflow-directory-prefs.ts",
      "scope": "Workflow Scripts tab directory table",
      "columnStorageKey": "p0003_workflow_panel_directory_columns",
      "presetsStorageKey": "p0003_workflow_panel_directory_column_presets",
      "displayPanelVariant": "panel",
      "panelFillRows": "pageSize",
      "partialPagePad": "invisible"
    },
    "notes": "Rail vs panel presets are independent localStorage scopes — never share storage keys across variants."
  },
  "smoke": {
    "workflowRail": "scripts/smoke-workflow-rail.mjs",
    "profilesPartialPage": "scripts/smoke-profiles-partial-page.mjs",
    "liveDevUrl": "http://127.0.0.1:5175/?stealthSmokePager=1",
    "profilesPagerSeed": {
      "webMockQuery": "stealthSmokePager=1",
      "minProfiles": 21,
      "dbSeedScript": "scripts/lib/seed-smoke-profiles-pager.cjs",
      "dbCleanupScript": "scripts/lib/cleanup-smoke-profiles-pager.cjs",
      "electronNodeRunner": "scripts/run-electron-node.mjs",
      "profileNameRange": "99001-99021"
    }
  },
  "health": {
    "status": "Beta",
    "note": "Requires CloakBrowser binary (auto-download on first launch). No external antidetect app."
  },
  "engine": {
    "package": "cloakbrowser",
    "version": "0.4.8",
    "pinned": true,
    "bumpPolicy": "docs/ENGINE-CLOAKBROWSER.md#bump-policy",
    "forkDecision": "docs/cloakbrowser-fork-evaluation.md#decision-record",
    "updatedAt": "2026-07-06"
  },
  "uiScreens": [
    {
      "screen": "profiles",
      "template": "inbox-split",
      "golden": "P0020/notes",
      "notes": "HubDirectoryScreen + Open URL rail"
    },
    {
      "screen": "workflow",
      "template": "inbox-split",
      "golden": "P0004/hub-ui/workflows",
      "notes": "HubSplitWorkspaceScreen header; WorkflowFilterPane in left pane"
    },
    {
      "screen": "settings",
      "template": "settings-modal",
      "notes": "StealthDisplayPrefs modal — engine health, data dir, theme (not a nav tab)"
    }
  ],
  "urls": {
    "local": "http://127.0.0.1:5175"
  },
  "deployTarget": "github-release",
  "github": {
    "repo": "tuanhoangfx/Stealth-Browser-Console",
    "branch": "main",
    "manifestPath": "tool.manifest.json",
    "visibility": "public",
    "visibilityUpdatedAt": "2026-07-08T00:13:51.000Z",
    "toggleVisibility": "node scripts/toggle-stealth-repo-visibility.mjs"
  },
  "manifestUpdatedAt": "2026-07-16T18:34:12.052Z",
  "release": {
    "version": "1.0.16",
    "updatedAt": "2026-07-07",
    "desktopAutoUpdate": "GitHub Releases. Public repo: /releases/latest/download/latest.yml. Private repo: STEALTH_UPDATER_GH_TOKEN baked at build (write-updater-auth.mjs). NSIS auto-download + install on quit.",
    "latestPublished": {
      "tag": "v1.0.1",
      "url": "https://github.com/tuanhoangfx/Stealth-Browser-Console/releases/tag/v1.0.1",
      "publishedAt": "2026-07-08T14:57:21.270Z"
    }
  },
  "ship": {
    "schemaVersion": 1,
    "fastPath": "Deploy",
    "releasePath": "Release",
    "deployTarget": "github-release",
    "playbook": "Tool/docs/playbooks/release-fast-path.md",
    "script": "powershell -File E:\\Dev\\Tool\\scripts\\ship-product.ps1",
    "preShip": [
      "check-version-sync",
      "build"
    ],
    "preShipCommands": {
      "check-version-sync": "node E:\\Dev\\Tool\\scripts\\check-version-sync.mjs --product-root . --no-warn-published",
      "build": "node scripts/run-build.mjs"
    },
    "syncedAt": "2026-07-16T19:14:23.633Z"
  }
}
